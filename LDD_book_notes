printk_ratelimit helps to avoid continuous prints, 
/proc/sys/kernel/printk_ratelimit_burst sets the max continuous prints allowed,
/proc/sys/kernel/printk_ratelimit - delay for enabling the prints again after limiting.

if(printk_ratelimit())
{
  printk("hello \n");
}

root@beaglebone:/home/args# cat /proc/sys/kernel/printk_ratelimit
5
root@beaglebone:/home/args# cat /proc/sys/kernel/printk_ratelimit_burst
10
root@beaglebone:/home/args#


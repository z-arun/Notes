MOV   -> MOV Rd, Operand             
         MOV r0, #5                  
         Copies value into register (move data)

MVN   -> MVN Rd, Operand             
         MVN r0, #0                  
         Move NOT (bitwise invert operand and store)

ADD   -> ADD Rd, Rn, Operand2        
         ADD r0, r1, r2              
         Adds two values (r0 = r1 + r2)

ADC   -> ADC Rd, Rn, Operand2        
         ADC r0, r1, r2              
         Add with carry (used in multi-word arithmetic)

SUB   -> SUB Rd, Rn, Operand2        
         SUB r0, r1, r2              
         Subtract (r0 = r1 - r2)

SBC   -> SBC Rd, Rn, Operand2        
         SBC r0, r1, r2              
         Subtract with carry (borrow)

RSB   -> RSB Rd, Rn, Operand2        
         RSB r0, r1, r2              
         Reverse subtract (r0 = r2 - r1)

MUL   -> MUL Rd, Rn, Rm              
         MUL r0, r1, r2              
         Multiply two registers

MLA   -> MLA Rd, Rn, Rm, Ra          
         MLA r0, r1, r2, r3          
         Multiply accumulate (r0 = r1*r2 + r3)

AND   -> AND Rd, Rn, Operand2        
         AND r0, r1, r2              
         Bitwise AND

ORR   -> ORR Rd, Rn, Operand2        
         ORR r0, r1, r2              
         Bitwise OR

EOR   -> EOR Rd, Rn, Operand2        
         EOR r0, r1, r2              
         Bitwise XOR

BIC   -> BIC Rd, Rn, Operand2        
         BIC r0, r1, #1              
         Bit clear (r0 = r1 & ~operand)

CMP   -> CMP Rn, Operand2            
         CMP r0, #10                 
         Compare values (sets flags, no result stored)

CMN   -> CMN Rn, Operand2            
         CMN r0, r1                  
         Compare negative (like addition for flags)

TST   -> TST Rn, Operand2            
         TST r0, #1                  
         Test bits using AND (flags only)

TEQ   -> TEQ Rn, Operand2            
         TEQ r0, r1                  
         Test equality using XOR (flags only)

LSL   -> LSL Rd, Rn, #shift          
         LSL r0, r1, #2              
         Logical left shift (multiply by 2^n)

LSR   -> LSR Rd, Rn, #shift          
         LSR r0, r1, #1              
         Logical right shift (divide unsigned)

ASR   -> ASR Rd, Rn, #shift          
         ASR r0, r1, #1              
         Arithmetic right shift (preserves sign)

ROR   -> ROR Rd, Rn, #shift          
         ROR r0, r1, #4              
         Rotate bits right

RRX   -> RRX Rd, Rn                  
         RRX r0, r1                  
         Rotate right with carry flag

LDR   -> LDR Rd, [Rn]                
         LDR r0, [r1]                
         Load word from memory

LDR   -> LDR Rd, [Rn, #offset]       
         LDR r0, [r1, #4]            
         Load with offset

LDR   -> LDR Rd, =value              
         LDR r0, =0x1234             
         Load immediate constant (pseudo)

STR   -> STR Rd, [Rn]                
         STR r0, [r1]                
         Store word to memory

STR   -> STR Rd, [Rn, #offset]       
         STR r0, [r1, #4]            
         Store with offset

LDRB  -> LDRB Rd, [Rn]               
         LDRB r0, [r1]               
         Load byte (8-bit)

STRB  -> STRB Rd, [Rn]               
         STRB r0, [r1]               
         Store byte

LDRH  -> LDRH Rd, [Rn]               
         LDRH r0, [r1]               
         Load halfword (16-bit)

STRH  -> STRH Rd, [Rn]               
         STRH r0, [r1]               
         Store halfword

LDM   -> LDMIA Rn!, {reglist}        
         LDMIA r0!, {r1-r3}          
         Load multiple registers

STM   -> STMIA Rn!, {reglist}        
         STMIA r0!, {r1-r3}          
         Store multiple registers

PUSH  -> PUSH {reglist}              
         PUSH {r0, r1}               
         Push registers to stack

POP   -> POP {reglist}               
         POP {r0, r1}                
         Pop registers from stack

B     -> B label                     
         B loop                      
         Unconditional branch (jump)

BL    -> BL function                 
         BL func                     
         Branch with link (function call, saves return addr)

BX    -> BX Rm                       
         BX lr                       
         Branch to register (used for return)

BLX   -> BLX Rm                      
         BLX r3                      
         Branch with link to register

BEQ   -> BEQ label                   
         BEQ equal                   
         Branch if equal (Z flag set)

BNE   -> BNE label                   
         BNE notequal                
         Branch if not equal

BGT   -> BGT label                   
         BGT greater                 
         Branch if greater than

BLT   -> BLT label                   
         BLT less                    
         Branch if less than

BGE   -> BGE label                   
         BGE ge                      
         Branch if greater or equal

BLE   -> BLE label                   
         BLE le                      
         Branch if less or equal

SVC   -> SVC #imm                    
         SVC #0                      
         Software interrupt (system call)

MRS   -> MRS Rd, CPSR                
         MRS r0, CPSR                
         Move status register to register

MSR   -> MSR CPSR, Rn                
         MSR CPSR, r0                
         Write to status register

NOP   -> NOP                         
         NOP                         
         No operation (does nothing)

WFI   -> WFI                         
         WFI                         
         Wait for interrupt (low power)

WFE   -> WFE                         
         WFE                         
         Wait for event

SEV   -> SEV                         
         SEV                         
         Send event to wake cores

BKPT  -> BKPT #imm                   
         BKPT #0                     
         Breakpoint for debugging

UMULL -> UMULL RdLo, RdHi, Rn, Rm    
         UMULL r0, r1, r2, r3        
         Unsigned long multiply (64-bit result)

SMULL -> SMULL RdLo, RdHi, Rn, Rm    
         SMULL r0, r1, r2, r3        
         Signed long multiply

LDREX -> LDREX Rd, [Rn]              
         LDREX r0, [r1]              
         Load exclusive (for atomic ops)

STREX -> STREX Rd, Rm, [Rn]          
         STREX r2, r0, [r1]          
         Store exclusive (atomic write)
